@page "/"
@page "/login"
@layout EmptyLayout
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>Iniciar sesión</PageTitle>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-header">
                    <h5 class="mb-0">Iniciar sesión</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label" for="user">Usuario</label>
                        <input id="user" class="form-control" @bind="_user" @bind:event="oninput" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="password">Contraseña</label>
                        <input id="password" type="password" class="form-control" @bind="_password" @bind:event="oninput" />
                    </div>
                    @if (!string.IsNullOrEmpty(_error))
                    {
                        <div class="alert alert-warning" role="alert">@_error</div>
                    }
                    <button type="button" class="btn btn-primary w-100" disabled="@_busy" @onclick="LoginAsync">
                        @(_busy ? "Autenticando..." : "Iniciar Sesión")
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Inject] private Client Client { get; set; } = default!;
    [Inject] private AuthSession AuthSession { get; set; } = default!;
    [Inject] private IConfiguration Configuration { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;

    private string _user = "";
    private string _password = "";
    private string? _error;
    private bool _busy;

    private async Task LoginAsync()
    {
        _error = null;
        _busy = true;

        var authUrl = Configuration["AuthServerUrl"] ?? "http://localhost:5155";
        var clientSecret = Configuration["AuthClientSecret"] ?? string.Empty;

        if (string.IsNullOrWhiteSpace(clientSecret))
        {
            _error = "Falta configurar AuthClientSecret en appsettings.json.";
            _busy = false;
            return;
        }

        var authResult = await Client.LoginAsync(authUrl, _user, _password, clientSecret);

        if (authResult.IsSuccess)
        {
            AuthSession.AccessToken = authResult.AccessToken;
            await InvokeAsync(() => Navigation.NavigateTo("/telemetry", replace: false));
            return;
        }

        _error = authResult.ErrorMessage;
        _password = "";

        _busy = false;
    }
}
